# Database MySQL di Aiven (WAJIB menyertakan parameter SSL, mis. ?sslaccept=strict)
DATABASE_URL="mysql://avnadmin:YOUR_AIVEN_PASSWORD@your-mysql-service.aivencloud.com:25060/sinergo_magang?sslaccept=strict"

# Konfigurasi SSO SACIBIRU (tanpa garis miring / di akhir SSO_URL; harus persis sama dengan klaim iss JWT)
SSO_URL="https://verval-two.vercel.app"
SSO_CLIENT_ID="sinergo-modul-magang"
SSO_CLIENT_SECRET="isi_rahasia_klien_dari_admin_sso"
SSO_REDIRECT_URI="http://localhost:3000/api/auth/callback/sacibiru"

# Konfigurasi NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti_dengan_random_secret_minimal_32_byte_base64"
